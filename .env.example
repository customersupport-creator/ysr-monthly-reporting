# Required — your Airtable Personal Access Token (create at https://airtable.com/create/tokens)
# Scopes needed: data.records:read  (and data.records:write if you use the in-app Monthly Entry form)
# Access: the "Facility Management Database" base
AIRTABLE_TOKEN=pat_your_token_here

# Optional — these already default to your base/tables, override only if they change
AIRTABLE_BASE_ID=app9iYUN8J3z2wjXN
MONTHLY_TABLE=tblJ7i6J3wxf03Kxk
TOWING_TABLE=tblLgNB8RQvy4xiW5
TOWING_DATE_FIELD=DATE
